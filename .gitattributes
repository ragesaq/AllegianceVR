# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.cpp text
*.h text
*.pch text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.vcxproj text eol=crlf

# HyperBench-owned, fork-only paths (see AGENTS.md): LF in every checkout,
# whatever core.autocrlf says. Upstream files keep the rules above.
/AGENTS.md text eol=lf
/STARTER_MANIFEST.json text eol=lf
/DAG.json text eol=lf
/LEDGER.md text eol=lf
/memory/** text eol=lf
/knowledge/** text eol=lf
/docs/** text eol=lf
/tools/** text eol=lf
/.claude/** text eol=lf
